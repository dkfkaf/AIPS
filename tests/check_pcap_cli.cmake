if(NOT DEFINED MINIIPS_EXECUTABLE OR NOT EXISTS "${MINIIPS_EXECUTABLE}")
    message(FATAL_ERROR "The miniips executable is missing.")
endif()
if(NOT DEFINED FIXTURE_DIRECTORY)
    message(FATAL_ERROR "The fixture directory is missing.")
endif()

set(expected_exit 0)
set(expected_errors "")
if(CLI_CASE STREQUAL "normal")
    set(expected_summary "pcap_summary packets=2 parsed=2 skipped=0")
elseif(CLI_CASE STREQUAL "mixed")
    set(expected_summary "pcap_summary packets=2 parsed=1 skipped=1")
    set(expected_errors "reason=truncated_ethernet")
elseif(CLI_CASE STREQUAL "empty")
    set(expected_summary "pcap_summary packets=0 parsed=0 skipped=0")
elseif(CLI_CASE STREQUAL "truncated" OR CLI_CASE STREQUAL "unsupported")
    set(expected_exit 1)
    set(expected_errors "capture_error:")
else()
    message(FATAL_ERROR "Unknown PCAP CLI test case: ${CLI_CASE}")
endif()

execute_process(
    COMMAND "${MINIIPS_EXECUTABLE}" --mode pcap --input "${FIXTURE_DIRECTORY}/${CLI_CASE}.pcap"
    RESULT_VARIABLE actual_exit
    OUTPUT_VARIABLE output
    ERROR_VARIABLE errors
    TIMEOUT 5
)
if(NOT "${actual_exit}" STREQUAL "${expected_exit}")
    message(FATAL_ERROR "Expected ${expected_exit}, got ${actual_exit}: ${errors}")
endif()
if(expected_exit EQUAL 0)
    string(FIND "${output}" "${expected_summary}" summary_position)
    if(summary_position LESS 0)
        message(FATAL_ERROR "Wrong or missing summary: ${output}")
    endif()
else()
    if(output MATCHES "pcap_summary")
        message(FATAL_ERROR "Failed capture must not report a successful summary.")
    endif()
endif()
if(expected_errors STREQUAL "")
    if(NOT errors STREQUAL "")
        message(FATAL_ERROR "Unexpected stderr: ${errors}")
    endif()
elseif(NOT errors MATCHES "${expected_errors}")
    message(FATAL_ERROR "Missing expected error: ${errors}")
endif()
if(CLI_CASE STREQUAL "normal")
    foreach(field IN ITEMS "protocol=tcp" "src_port=12345" "dst_port=8080" "protocol=udp")
        string(FIND "${output}" "${field}" field_position)
        if(field_position LESS 0)
            message(FATAL_ERROR "Missing packet field ${field}: ${output}")
        endif()
    endforeach()
endif()
if(output MATCHES "HELLO")
    message(FATAL_ERROR "The CLI must not dump raw packet payload.")
endif()
